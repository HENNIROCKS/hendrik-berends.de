{
  "name": "getkirby/plainkit",
  "description": "Kirby Plainkit",
  "type": "project",
  "keywords": [
    "kirby",
    "cms",
    "plainkit"
  ],
  "authors": [
    {
      "name": "Bastian Allgeier",
      "email": "bastian@getkirby.com",
      "homepage": "https://getkirby.com"
    }
  ],
  "homepage": "https://getkirby.com",
  "support": {
    "email": "support@getkirby.com",
    "forum": "https://forum.getkirby.com",
    "source": "https://github.com/getkirby/plainkit"
  },
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "getkirby/cms": "^5.2",
    "timnarr/kirby-imagex": "^0.1.4",
    "distantnative/retour-for-kirby": "^5.5",
    "medienbaecker/kirby-mastodon": "^2.0",
    "foerdeliebe-sh/kirby-website-carbon": "^1.0",
    "beebmx/kirby-env": "^5.2"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 kirby/router.php"
    ]
