{
  "name": "hendrik-berends-de",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:js": "webpack",
    "build:css:legacy": "sass src/scss/styles.scss assets/css/theme.min.css --style compressed",
    "build:css:tailwind": "tailwindcss -i src/css/styles.css -o assets/css/style.min.css --minify",
    "build:css": "npm run build:css:legacy && npm run build:css:tailwind",
    "build": "npm run build:js && npm run build:css",
    "watch:js": "webpack --watch",
    "watch:css:legacy": "sass --watch src/scss/styles.scss assets/css/theme.min.css --style compressed",
    "watch:css:tailwind": "tailwindcss -i src/css/styles.css -o assets/css/style.min.css --watch",
    "watch": "concurrently \"npm run watch:js\" \"npm run watch:css:legacy\" \"npm run watch:css:tailwind\""
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "concurrently": "^9.2.1",
    "glightbox": "^3.3.1",
    "sass": "^1.93.2",
    "tailwindcss": "^4.3.0",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  }
}
